generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model EventSetting {
  id            String   @id @default(uuid())
  title         String
  description   String   @db.Text
  eventDate     DateTime
  location      String
  themeColor    String   @default("#000000")
  coverImageUrl String?
}

model Guest {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  isAttending Boolean
  message     String?  @db.Text
  createdAt   DateTime @default(now())
}
